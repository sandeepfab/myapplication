<Project>
  <PropertyGroup>
    <WebPublishMethod>FTP</WebPublishMethod>
    <ResourceId>/subscriptions/856a41a9-129d-4bf9-9416-3df32e90b5a3/resourceGroups/class-demo/providers/Microsoft.Web/sites/mydemoaztestapp-01</ResourceId>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://mydemoaztestapp-01.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>18d9c97f-001c-4497-97ec-f2c5d53a8840</ProjectGuid>
    <publishUrl>ftps://waws-prod-yt1-101.ftp.azurewebsites.windows.net</publishUrl>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <FtpPassiveMode>true</FtpPassiveMode>
    <FtpSitePath>site/wwwroot</FtpSitePath>
    <UserName>mydemoaztestapp-01\$mydemoaztestapp-01</UserName>
    <_SavePWD>true</_SavePWD>
  </PropertyGroup>
</Project>